VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Canonical site URL used in password-reset email links (production builds).
# Local dev (npm run dev) always uses the current origin (http://localhost:5173)
# automatically, even if this variable is set.
VITE_SITE_URL=https://lokal-app-iota.vercel.app

# Gemini API key is now configured server-side in Supabase Edge Functions
# Set GEMINI_API_KEY in: Supabase Dashboard → Edge Functions → Settings
