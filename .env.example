VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Canonical site URL used in password-reset email links (production builds).
# Local dev (npm run dev) always uses the current origin (http://localhost:5173)
# automatically, even if this variable is set.
VITE_SITE_URL=https://lokal-app-iota.vercel.app

# Gemini API key is now configured server-side in Supabase Edge Functions
# Set GEMINI_API_KEY in: Supabase Dashboard → Edge Functions → Settings

# Cloudflare Turnstile PUBLIC site key (not a secret — it ships in the browser
# bundle by design).
#   Local dev: Cloudflare's official always-passing test site key
#              https://developers.cloudflare.com/turnstile/testing/test-keys/
#              VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   Production: set VITE_TURNSTILE_SITE_KEY in the Vercel project settings for
#               BOTH Production and Preview. Vite inlines env vars at build
#               time, so a redeploy is required after any change.
# The matching SECRET key must NEVER go in any VITE_ variable. It belongs only
# in Supabase Dashboard → Authentication → Bot and Abuse Protection.
VITE_TURNSTILE_SITE_KEY=
