VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Canonical site URL used in password-reset email links (production builds).
# Local dev (npm run dev) always uses the current origin (http://localhost:5173)
# automatically, even if this variable is set.
VITE_SITE_URL=https://lokal-app-iota.vercel.app

# Gemini API key is now configured server-side in Supabase Edge Functions
# Set GEMINI_API_KEY in: Supabase Dashboard → Edge Functions → Settings

# NOTE: Cloudflare Turnstile was removed from the frontend. Authentication
# CAPTCHA protection must be DISABLED in Supabase Dashboard → Authentication
# → Bot and Abuse Protection, or every signup / sign-in / reset / resend
# request will fail with "captcha_failed" and no UI can supply a token.

# 6-digit email OTP verification panel (VITE_OTP_ENABLED) — PRIMARY.
#
# The OTP flow is delivered by Supabase Auth's Send Email hook
# (supabase/functions/send-auth-email -> EmailJS). That chain only works when
# ALL of the following are configured — none of which live in this repo:
#   1. Supabase Dashboard -> Authentication -> Hooks -> "Send Email" hook is
#      ENABLED and points at the send-auth-email Edge Function (deployed).
#   2. Edge Function secrets are set:
#        SEND_EMAIL_HOOK_SECRET, APP_SITE_URL, EMAILJS_SERVICE_ID,
#        EMAILJS_TEMPLATE_ID (must render {{code}} as a 6-digit code),
#        EMAILJS_TEMPLATE_ACCOUNT_ID, EMAILJS_PUBLIC_KEY
#   3. EmailJS has a verified sending domain.
#   4. Authentication -> Providers -> Email -> "Confirm email" is ON.
#
# Unset (or "true") shows the 6-digit CODE panel — the default. Set to
# "false" ONLY to roll back to the confirmation-LINK panel (e.g. while the
# hook chain is down), and redeploy — Vite inlines env vars at build time.
# VITE_OTP_ENABLED=false
